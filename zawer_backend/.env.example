PORT=5000
# Local Node: mongodb://localhost:27017/zawer
# Docker local-db service (docker compose up backend-local) overrides this with mongodb://mongo:27017/zawer
# Atlas: paste your Atlas connection string here
MONGO_URI=mongodb://localhost:27017/zawer
# REQUIRED: the server refuses to start without it (or with the example value below);
# use 32+ random chars - shorter secrets start with a warning.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
# development = return reset OTPs in API responses and log them to the console.
# Local testing only: NEVER use development in production (remove or set production).
NODE_ENV=development
# Only behind a reverse proxy/load balancer: hop count (e.g. 1) or comma list of
# trusted proxy IPs/subnets (e.g. loopback, 10.0.0.0/8) so rate limiting sees the
# real client IP. Leave unset for direct connections (else X-Forwarded-For is spoofable).
# TRUST_PROXY=1
